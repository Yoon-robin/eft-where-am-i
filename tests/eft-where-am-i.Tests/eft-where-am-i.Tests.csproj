<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 테스트 대상이 WinForms 앱이라 동일한 TFM 이 필요합니다. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>eft_where_am_i.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- 앱 프로젝트의 Tailwind 빌드 타깃이 테스트 빌드까지 끌고 오지 않도록 합니다. -->
    <SkipTailwindBuild>true</SkipTailwindBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\eft-where-am-i\eft-where-am-i.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
